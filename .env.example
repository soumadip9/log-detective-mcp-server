# Log Detective MCP Configuration

# Path to the sources configuration JSON file
LOG_DETECTIVE_SOURCES_CONFIG=sources.json

# Quick single-file local log configuration (alternative to JSON config)
# LOG_DETECTIVE_LOG_FILE=logs/app.log

# Authentication token for remote production deployments (Render, Cloud Run, etc.)
# If set, incoming MCP requests require "Authorization: Bearer <TOKEN>"
# Leave empty for local development and testing
MCP_AUTH_TOKEN=

# Server Binding
HOST=0.0.0.0
PORT=8000
